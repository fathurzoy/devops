# Salin file ini menjadi .env lalu ganti nilainya dengan milikmu sendiri.
# File .env asli JANGAN pernah di-commit ke Git.
GRAFANA_ADMIN_PASSWORD=ganti-dengan-password-grafana-kamu
PORTAINER_ADMIN_PASSWORD=ganti-dengan-password-portainer-kamu
# Alert Telegram (Grafana Alerting) — boleh kosong dulu; alert tidak terkirim
# sampai keduanya diisi. Cara mendapatkannya: lihat tutorial-ratelimit-logging-alert.md
# (bot token dari @BotFather, chat ID dari getUpdates setelah chat ke bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
