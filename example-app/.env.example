# Template secrets.env (per environment, HANYA di server, chmod 600, JANGAN masuk Git).
# Salin menjadi file "secrets.env" di folder environment masing-masing lalu isi:
POSTGRES_PASSWORD=ganti-dengan-password-kuat-unik-per-env
RABBITMQ_PASSWORD=ganti-dengan-password-kuat-unik-per-env
GATEWAY_ADMIN_TOKEN=ganti-dengan-token-acak-panjang
